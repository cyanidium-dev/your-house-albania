{
  "buildCommand": "npm run build:ci",
  "crons": [
    {
      "path": "/api/cron/update-currency-rates",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/search-alerts",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/leads-weekly",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/cron/sanity-changes",
      "schedule": "5 * * * *"
    }
  ],
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ]"
}
