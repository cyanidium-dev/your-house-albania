# Sanity (used by frontend + Studio)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# Sanity write client (cron patches siteSettings.exchangeRates)
# Falls back to NEXT_PUBLIC_SANITY_* if unset
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_API_VERSION=
# Token with write access (also accepts SANITY_API_TOKEN)
SANITY_WRITE_TOKEN=

# Currency rates cron (Vercel cron → /api/cron/update-currency-rates)
FIXER_API_KEY=
CRON_SECRET=

# Sanity content revalidation webhook (Sanity → POST /api/revalidate/sanity)
# Shared secret sent by the webhook as `Authorization: Bearer <secret>`.
# REQUIRED: the route is disabled (401) unless this is set. Use any long random string.
SANITY_REVALIDATE_SECRET=

# Public origin used for canonical/hreflang/sitemap/robots URLs.
# MUST match the exact serving host including subdomain — prod serves at www:
NEXT_PUBLIC_SITE_URL=https://www.domlivo.com

# Analytics loader gate (GTM + Clarity + consent banner activate only when "true")
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Telegram — general contacts (`POST /api/contact-agent`) and register (`POST /api/registration-request`) use TELEGRAM_GENERAL_CHAT_ID
# Required for production: real sendMessage
TELEGRAM_BOT_TOKEN=
TELEGRAM_GENERAL_CHAT_ID=
# Optional: override API host (default https://api.telegram.org)
TELEGRAM_API_BASE_URL=https://api.telegram.org
# Agent-branch stub / future per-agent inbox (not used by general contacts delivery today)
TELEGRAM_AGENT_CONTACT_CHAT_ID=
# Optional: set to "general", "agent", or "both" to force delivery failure (testing; general path skips real send when it triggers)
# TELEGRAM_DEBUG_STUB_FAIL=
# Optional: set to false to disable indexing of the site, false for dev, true for production
NEXT_PUBLIC_ENABLE_INDEXING=false

# ──────────────────────────────────────────────────────────
# Landing editor (/editor)
# Accessible ONLY via the dedicated /editor route tree.
# The public site never loads editor code.
# Requires SANITY_WRITE_TOKEN for persistence.
# ──────────────────────────────────────────────────────────
# Password for the editor login form
EDITOR_PASSWORD=
# HMAC secret used to sign the editor session cookie (any long random string).
# REQUIRED: editor login is disabled unless this is set. Do not reuse SANITY_WRITE_TOKEN.
EDITOR_SESSION_SECRET=

# ──────────────────────────────────────────────────────────
# AI property search (/[locale]/ai-search + POST /api/ai/chat)
# ──────────────────────────────────────────────────────────
# Anthropic API key. REQUIRED: without it the assistant is hidden everywhere
# (hero field, header icon) and the page falls back to a link to the catalog.
ANTHROPIC_API_KEY=
# Optional model override. Default: claude-sonnet-5
ANTHROPIC_MODEL=
